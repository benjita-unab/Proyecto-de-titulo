# Configuración de Base de Datos Supabase (Principal)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Configuración de Base de Datos SQLite (Respaldo Local / Failover)
SQLITE_DB_PATH=./movitech_backup.sqlite.json

# Bot de Telegram (Canal de pruebas y notas de voz)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_token_here

# Inteligencia Artificial Gemini (HTTPS)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_MS=3500

# Broker MQTT (Desacoplamiento asíncrono)
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC_INCOMING=movitech/incoming/requests
MQTT_TOPIC_OUTGOING=movitech/outgoing/responses

# Tareas Programadas (Cron de extracción y sincronización)
CRON_SYNC_INTERVAL_MS=21600000
